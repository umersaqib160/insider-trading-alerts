# Copy to .env for local development. Never commit the real .env.

# development | production
APP_ENV=development

# Local default is a SQLite file. Railway sets this to its Postgres URL.
DATABASE_URL=sqlite:///./dev.db

# Signs session cookies. Required in production: use a long random string.
SECRET_KEY=change-me

# From @BotFather. The username is without the leading @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# SEC asks every automated client to identify itself with a name and contact
# email. Required for the Filing Scout.
SEC_USER_AGENT="Behind The Curtain you@example.com"

# Quiver API key for Congress trades. Without it, the Scout skips Congress
# and says so in its report.
QUIVER_API_KEY=

# Local only: shows a "Dev login" button, because Telegram's login widget
# doesn't work on localhost. Ignored when APP_ENV=production.
DEV_LOGIN=true
# Telegram user id the dev login signs in as. Set it to your own id to get
# real test notifications locally (message @userinfobot to find it).
DEV_TELEGRAM_ID=1
